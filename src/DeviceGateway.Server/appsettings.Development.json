{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // 打开 SuperSocket 会话日志的 Debug 级别，便于观察心跳与位置数据是否正常到达。
      // session.Logger 的类别是 "SuperSocketService"（框架内部创建的），
      // 设备命令通过它写日志，所以要开这个类别才能看到。
      //
      // 设备每秒上报一次位置，用 Information 级别会刷屏，所以放在 Debug。
      "SuperSocketService": "Debug"
    }
  }
}
