<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SuperSocket.Command" Version="2.1.0" />
    <PackageReference Include="SuperSocket.Server" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeviceGateway.Shared\DeviceGateway.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      允许测试项目访问 internal 成员。

      目前只有 DeviceSession.SendSerializedAsync 需要 —— 它是"持锁发送"的可测试形态：
      生产路径传真正的 socket 发送，单元测试传记录用的假传输，
      从而能验证"同一会话上的并发发送不会字节交错"。
    -->
    <InternalsVisibleTo Include="DeviceGateway.Tests" />
  </ItemGroup>

</Project>
