{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "serverOptions": {
    "name": "DeviceGateway",
    "listeners": [
      {
        "ip": "any",
        "port": 5001,
        "backLog": 100,
        "noDelay": true
      }
    ],
    "idleSessionTimeOut": 600,
    "clearIdleSessionInterval": 120
  },

  "deviceGateway": {
    "heartbeatTimeoutSeconds": 90,
    "offlineScanIntervalSeconds": 10
  }
}
